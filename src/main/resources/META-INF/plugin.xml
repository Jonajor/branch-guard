<idea-plugin>
    <id>com.github.jonajor.branchguard</id>
    <name>Branch Guard</name>
    <vendor>jonajor</vendor>
    <description><![CDATA[
        <p>Prevent accidental development on protected branches.</p>
        <p>Branch Guard detects when you start editing code on branches like main, master, or develop and offers to create a ticket-based feature branch before you continue.</p>
        <p><b>Features:</b></p>
        <ul>
            <li>Protected branch detection</li>
            <li>Ticket-based branch creation</li>
            <li>Custom branch naming templates</li>
            <li>Git integration</li>
            <li>Lightweight workflow protection</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.BranchGuardBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.jonajor.branchguard.settings.BranchGuardSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.jonajor.branchguard.settings.BranchGuardConfigurable"
            id="com.github.jonajor.branchguard.settings"
            displayName="Branch Guard"/>
        <notificationGroup
            id="Branch Guard"
            displayType="BALLOON"/>
        <postStartupActivity implementation="com.github.jonajor.branchguard.settings.BranchGuardStartupActivity"/>
    </extensions>
</idea-plugin>
